# ============================================================
# UDES Food — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está ignorado por git: NUNCA lo subas al repo.
# ============================================================

# --- Supabase (cliente, público) ----------------------------
# URL del proyecto: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
# Clave anon/public (segura para el navegador; la protege RLS)
VITE_SUPABASE_ANON_KEY=

# --- Supabase (solo backend / CLI, SECRETAS) ----------------
# Token de acceso personal para la CLI (nunca en el navegador)
SUPABASE_ACCESS_TOKEN=
# Clave service_role: solo Edge Functions / scripts locales (nunca en VITE_*)
SUPABASE_SERVICE_ROLE_KEY=

# --- Identidad ----------------------------------------------
# email | entra  (entra requiere registrar la app en el tenant de la UDES)
VITE_AUTH_PROVIDER=email

# --- Entra ID (solo si VITE_AUTH_PROVIDER=entra) ------------
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# --- Wompi (sandbox primero) --------------------------------
# Llave pública (empieza por pub_)
WOMPI_PUBLIC_KEY=
# Llave privada (empieza por prv_) — SOLO backend
WOMPI_PRIVATE_KEY=
# Secreto de eventos (empieza por events_) — SOLO backend
WOMPI_EVENTS_SECRET=
# sandbox | prod  (entornos independientes: las llaves no se comparten)
WOMPI_ENV=sandbox

# --- Email transaccional (Resend) ---------------------------
# API key (empieza por re_) — SOLO backend
RESEND_API_KEY=
# Remitente verificado en Resend, ej. UDES Food <pedidos@tudominio.com>
EMAIL_FROM=

# --- Aplicación ---------------------------------------------
# URL pública de la SPA (sin barra final)
APP_URL=http://localhost:5173

# --- Administración -----------------------------------------
# Correo del primer admin (debe existir en el directorio `estudiantes`)
ADMIN_EMAIL=
